{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "mods/manager-home/**/*.ts", "mods/ready-guard/hooks/**/*.ts", "mods/size-reminder/hooks/**/*.ts"],
  // register.ts alone is out: it imports the engine's gitignored types, which only the mod's own tsconfig has. Everything
  // else in the mod is pure and in this build.
  "exclude": ["mods/ready-guard/hooks/register.ts", "mods/size-reminder/hooks/register.ts"]
}
