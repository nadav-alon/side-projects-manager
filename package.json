{
  "name": "side-projects-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Manager for side projects: the morning loop and the new-project command.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "morning-run": "./dist/bin/morning-run.js",
    "new-project": "./dist/bin/new-project.js",
    "loop-status": "./dist/bin/status.js",
    "loop-halt": "./dist/bin/halt.js",
    "loop-resume": "./dist/bin/resume.js"
  },
  "files": [
    "dist",
    "docs/agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "morning-run": "node src/bin/morning-run.ts",
    "new-project": "node src/bin/new-project.ts",
    "status": "node src/bin/status.ts",
    "halt": "node src/bin/halt.ts",
    "resume": "node src/bin/resume.ts",
    "triggers:install": "bash scripts/install-triggers.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "sandbox:build": "docker build --label side-projects-sandbox.inputs=$(node scripts/sandbox-inputs-digest.ts) --build-arg CLAUDE_CODE_VERSION=$(npm view @anthropic-ai/claude-code version) -t side-projects-sandbox:latest .",
    "sandbox:verify": "docker run --rm -v \"$PWD/scripts:/scripts:ro\" -v \"$PWD/src/error-message.ts:/src/error-message.ts:ro\" --entrypoint node side-projects-sandbox:latest /scripts/verify-harness.ts",
    "sandbox:verify:pinned": "docker run --rm --user 4242:4242 -v \"$PWD/scripts:/scripts:ro\" -v \"$PWD/src/error-message.ts:/src/error-message.ts:ro\" --entrypoint node side-projects-sandbox:latest /scripts/verify-harness.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.2"
  }
}
